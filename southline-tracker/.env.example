# Copy to .env.local and fill in. Everything is optional:
# with nothing set the app runs on mock data with rule-based AI.

# --- Login (off unless you set one of these) ---
# Turn a login ON before putting the app online.
# Built-in logins: comma-separated login:password pairs (a login can be an email or a
# username). Don't use commas in passwords.
# APP_USERS=you@example.com:change-me,partner:change-me-too
# Or use Supabase Auth users instead:
# LOGIN=supabase
AUTH_SECRET=                        # long random string, e.g. `openssl rand -hex 32` (also locks keys saved on the API keys page)
# SECRETS_KEY=                      # optional: lock saved API keys with this instead of AUTH_SECRET

# --- Supabase (Postgres + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only - never expose
ALLOWED_EMAILS=you@southline.ie     # comma separated; who may log in

# --- Webhooks / sync ---
INGEST_SECRET=                      # long random string, e.g. `openssl rand -hex 24`
APP_URL=https://your-app.vercel.app # used to show webhook URLs on the Import page

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # default

# --- GoHighLevel (optional - webhooks work without it) ---
GHL_API_KEY=                        # Private Integration token (scope: contacts.readonly)
GHL_LOCATION_ID=                    # sub-account / location id, for "Test connection"
# GHL_API_VERSION=2021-07-28

# --- SendMode (optional - inbound + delivery webhooks work without it) ---
SENDMODE_ACCESS_KEY=                # SendMode portal: Settings → API Settings → access key
SENDMODE_SENDER_ID=Southline        # sender name/number shown on texts (must be approved in SendMode)

# --- Optional API sync ---
INSTANTLY_API_KEY=                  # Instantly API v2 key, for /api/sync/instantly
