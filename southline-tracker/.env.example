# Copy to .env.local and fill in. Everything is optional:
# with nothing set the app runs on mock data with rule-based AI.

# --- Supabase (Postgres + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only - never expose
ALLOWED_EMAILS=you@southline.ie     # comma separated; who may log in

# --- Webhooks / sync ---
INGEST_SECRET=                      # long random string, e.g. `openssl rand -hex 24`
APP_URL=https://your-app.vercel.app # used to show webhook URLs on the Import page

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # default

# --- Optional API sync ---
INSTANTLY_API_KEY=                  # Instantly API v2 key, for /api/sync/instantly
